pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {WitnessLib} from "../src/libraries/WitnessLib.sol";
import {ChannelTypes} from "../src/libraries/ChannelTypes.sol";
import {L2AnchorInbox} from "../src/L2AnchorInbox.sol";
import {L1StateReader} from "../src/L1StateReader.sol";

contract WitnessHarness {
    function verify(bytes calldata data) external pure returns (WitnessLib.Read[] memory, bytes32 anchorId) {
        WitnessLib.WitnessPackage memory p = WitnessLib.decode(data);
        return (WitnessLib.verify(p), ChannelTypes.anchorId(p.anchor));
    }

    function decode(bytes calldata data) external pure returns (WitnessLib.WitnessPackage memory) {
        return WitnessLib.decode(data);
    }
}

/// Against fixtures/witnesses/read-and-split.json (generated by crates/channel-witness).
contract WitnessTest is Test {
    string json;
    WitnessHarness h;
    address fixture;
    bytes32 slot;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/../fixtures/witnesses/read-and-split.json"));
        h = new WitnessHarness();
        fixture = vm.parseJsonAddress(json, ".fixture");
        slot = vm.parseJsonBytes32(json, ".shareSlot");
    }

    function test_h0AndH1VerifyLikeRust() public view {
        string[2] memory hs = [".h0", ".h1"];
        for (uint256 i; i < 2; ++i) {
            bytes memory pkg = vm.parseJsonBytes(json, string.concat(hs[i], ".package"));
            assertEq(keccak256(pkg), vm.parseJsonBytes32(json, string.concat(hs[i], ".packageHash")));
            (WitnessLib.Read[] memory reads, bytes32 id) = h.verify(pkg);
            assertEq(id, vm.parseJsonBytes32(json, string.concat(hs[i], ".anchor.id")));
            assertEq(WitnessLib.find(reads, fixture, slot), vm.parseJsonUint(json, string.concat(hs[i], ".shareBps")));
            // Proven-absent slot and proven-absent account read zero.
            assertEq(WitnessLib.find(reads, fixture, bytes32(uint256(999))), 0);
            assertEq(WitnessLib.find(reads, vm.parseJsonAddress(json, ".nobody"), slot), 0);
        }
    }

    function test_unwitnessedReadReverts() public {
        bytes memory pkg = vm.parseJsonBytes(json, ".h1.package");
        (WitnessLib.Read[] memory reads,) = h.verify(pkg);
        vm.expectRevert(abi.encodeWithSelector(WitnessLib.NotWitnessed.selector, fixture, bytes32(uint256(5))));
        this.find(reads, fixture, bytes32(uint256(5)));
    }

    function find(WitnessLib.Read[] memory reads, address a, bytes32 s) external pure returns (uint256) {
        return WitnessLib.find(reads, a, s);
    }

    function test_badPackagesRevert() public {
        string[4] memory bad = ["mixedRoots", "wrongValue", "presentClaimedAbsent", "unsorted"];
        for (uint256 i; i < bad.length; ++i) {
            bytes memory pkg = vm.parseJsonBytes(json, string.concat(".bad.", bad[i]));
            (bool ok,) = address(h).call(abi.encodeCall(WitnessHarness.verify, (pkg)));
            assertFalse(ok, bad[i]);
        }
    }

    function test_nonCanonicalEncodingReverts() public {
        bytes memory pkg = vm.parseJsonBytes(json, ".h1.package");
        vm.expectRevert(WitnessLib.NonCanonicalPackage.selector);
        h.verify(bytes.concat(pkg, new bytes(32)));
    }

    function test_l1StateReaderSingleSlot() public {
        L2AnchorInbox inbox = new L2AnchorInbox(address(this), address(0), 11155111);
        L1StateReader reader = new L1StateReader(inbox);
        bytes32 id = inbox.post(vm.parseJsonBytes(json, ".h1.rawHeader"));
        assertEq(id, vm.parseJsonBytes32(json, ".h1.anchor.id"));
        WitnessLib.WitnessPackage memory p = h.decode(vm.parseJsonBytes(json, ".h1.package"));
        // accounts sorted: find the fixture and its share slot.
        bytes[] memory accountProof;
        for (uint256 i; i < p.accounts.length; ++i) {
            if (p.accounts[i].account == fixture) accountProof = p.accounts[i].proof;
        }
        bytes[] memory storageProof;
        for (uint256 i; i < p.slots.length; ++i) {
            if (p.slots[i].account == fixture && p.slots[i].slot == slot) storageProof = p.slots[i].proof;
        }
        assertEq(uint256(reader.readStorage(id, fixture, slot, accountProof, storageProof)), 7000);
        // H0's storage proof at H1's anchor.
        WitnessLib.WitnessPackage memory p0 = h.decode(vm.parseJsonBytes(json, ".h0.package"));
        for (uint256 i; i < p0.slots.length; ++i) {
            if (p0.slots[i].account == fixture && p0.slots[i].slot == slot) storageProof = p0.slots[i].proof;
        }
        vm.expectRevert();
        reader.readStorage(id, fixture, slot, accountProof, storageProof);
        vm.expectRevert(abi.encodeWithSelector(L1StateReader.UnknownAnchor.selector, bytes32(uint256(1))));
        reader.readStorage(bytes32(uint256(1)), fixture, slot, accountProof, storageProof);
    }
}
