pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {RLP} from "../src/libraries/RLP.sol";
import {MerklePatricia} from "../src/libraries/MerklePatricia.sol";
import {EthTypes} from "../src/libraries/EthTypes.sol";

contract Harness {
    function get(bytes32 root, bytes memory key, bytes[] memory proof) external pure returns (bool, bytes memory) {
        return MerklePatricia.get(root, key, proof);
    }

    function receipt(bytes memory enc) external pure returns (uint8 t, bool ok, uint256 nlogs) {
        RLP.Item[] memory logs;
        (t, ok, logs) = EthTypes.decodeReceipt(enc);
        nlogs = logs.length;
    }

    function log(bytes memory enc, uint256 i) external pure returns (EthTypes.Log memory) {
        (,, RLP.Item[] memory logs) = EthTypes.decodeReceipt(enc);
        return EthTypes.decodeLog(logs[i]);
    }

    function header(bytes memory raw) external pure returns (EthTypes.HeaderFields memory) {
        return EthTypes.decodeHeader(raw);
    }
}

/// Against fixtures/receipts/block-130.json (generated by crates/channel-receipts).
contract ReceiptProofTest is Test {
    string json;
    Harness h;
    bytes32 root;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/../fixtures/receipts/block-130.json"));
        h = new Harness();
        root = vm.parseJsonBytes32(json, ".header.receiptsRoot");
    }

    function _case(uint256 i) internal view returns (uint256 index, bytes memory rcpt, bytes[] memory proof) {
        string memory p = string.concat(".cases[", vm.toString(i), "]");
        index = vm.parseJsonUint(json, string.concat(p, ".index"));
        rcpt = vm.parseJsonBytes(json, string.concat(p, ".receipt"));
        proof = vm.parseJsonBytesArray(json, string.concat(p, ".proof"));
    }

    function test_headerCommitsToReceiptsRoot() public view {
        bytes memory raw = vm.parseJsonBytes(json, ".header.raw");
        EthTypes.HeaderFields memory f = h.header(raw);
        assertEq(f.hash, vm.parseJsonBytes32(json, ".header.hash"));
        assertEq(f.receiptsRoot, root);
        assertEq(f.number, 1);
    }

    function test_indexKeys() public pure {
        assertEq(MerklePatricia.indexKey(0), hex"80");
        assertEq(MerklePatricia.indexKey(1), hex"01");
        assertEq(MerklePatricia.indexKey(127), hex"7f");
        assertEq(MerklePatricia.indexKey(128), hex"8180");
        assertEq(MerklePatricia.indexKey(256), hex"820100");
    }

    function test_allCasesProveAndDecode() public view {
        for (uint256 c; c < 7; ++c) {
            (uint256 index, bytes memory rcpt, bytes[] memory proof) = _case(c);
            (bool found, bytes memory v) = h.get(root, MerklePatricia.indexKey(index), proof);
            assertTrue(found);
            assertEq(v, rcpt);
            string memory p = string.concat(".cases[", vm.toString(c), "]");
            (uint8 t, bool ok,) = h.receipt(rcpt);
            assertEq(t, vm.parseJsonUint(json, string.concat(p, ".type")));
            assertEq(ok, vm.parseJsonBool(json, string.concat(p, ".status")));
        }
    }

    function test_outcomeLogDecodes() public view {
        (, bytes memory rcpt,) = _case(2); // index 2: executor outcome
        EthTypes.Log memory l = h.log(rcpt, 1);
        assertEq(l.emitter, vm.parseJsonAddress(json, ".executor"));
        assertEq(l.topics[0], vm.parseJsonBytes32(json, ".channelOutcomeTopic"));
        assertEq(l.topics.length, 3);
        assertEq(l.data.length, 96);
        (, bytes memory imp,) = _case(3); // index 7: impostor
        assertTrue(h.log(imp, 1).emitter != vm.parseJsonAddress(json, ".executor"));
    }

    function test_wrongIndexFailsOrIsAbsent() public {
        (, bytes memory rcpt, bytes[] memory proof) = _case(2);
        // The proof for index 2 cannot show index 3 present.
        try h.get(root, MerklePatricia.indexKey(3), proof) returns (bool found, bytes memory v) {
            assertTrue(!found || keccak256(v) != keccak256(rcpt));
            assertFalse(found);
        } catch {}
    }

    function test_tamperedNodesRevert() public {
        (uint256 index,, bytes[] memory proof) = _case(5); // index 128
        for (uint256 n; n < proof.length; ++n) {
            bytes[] memory bad = _copy(proof);
            bytes memory node = bad[n];
            node[node.length - 1] = bytes1(uint8(node[node.length - 1]) ^ 1);
            vm.expectRevert();
            h.get(root, MerklePatricia.indexKey(index), bad);
        }
    }

    function test_truncatedAndPaddedProofsRevert() public {
        (uint256 index,, bytes[] memory proof) = _case(5);
        bytes[] memory short = new bytes[](proof.length - 1);
        for (uint256 i; i < short.length; ++i) {
            short[i] = proof[i];
        }
        vm.expectRevert(MerklePatricia.InvalidProof.selector);
        h.get(root, MerklePatricia.indexKey(index), short);
        bytes[] memory long = new bytes[](proof.length + 1);
        for (uint256 i; i < proof.length; ++i) {
            long[i] = proof[i];
        }
        long[proof.length] = proof[0];
        vm.expectRevert(MerklePatricia.InvalidProof.selector);
        h.get(root, MerklePatricia.indexKey(index), long);
        vm.expectRevert(MerklePatricia.InvalidProof.selector);
        h.get(root, MerklePatricia.indexKey(index), new bytes[](0));
    }

    function test_otherRootReverts() public {
        (uint256 index,, bytes[] memory proof) = _case(2);
        vm.expectRevert(MerklePatricia.InvalidProof.selector);
        h.get(keccak256("other"), MerklePatricia.indexKey(index), proof);
    }

    function test_receiptTamperingRejected() public {
        (, bytes memory rcpt,) = _case(2); // EIP-1559, success
        bytes memory unknownType = bytes.concat(hex"7f", _slice(rcpt, 1));
        vm.expectRevert(EthTypes.BadReceipt.selector);
        h.receipt(unknownType);
        bytes memory trailing = bytes.concat(rcpt, hex"00");
        vm.expectRevert();
        h.receipt(trailing);
        // A retyped receipt still decodes, but it is not the leaf the proof commits to.
        bytes memory retyped = bytes.concat(hex"01", _slice(rcpt, 1));
        (uint8 t,,) = h.receipt(retyped);
        assertEq(t, 1);
        assertTrue(keccak256(retyped) != keccak256(rcpt));
    }

    function test_rlpRejectsNonCanonical() public {
        vm.expectRevert(RLP.RLPMalformed.selector);
        this.decodeUint(hex"8105"); // single byte < 0x80 must not be wrapped
        vm.expectRevert(RLP.RLPMalformed.selector);
        this.decodeUint(hex"820005"); // leading zero
        vm.expectRevert(RLP.RLPMalformed.selector);
        this.decodeUint(hex"b80105"); // long form for a short payload
        assertEq(this.decodeUint(hex"820105"), 0x0105);
    }

    function decodeUint(bytes memory b) external pure returns (uint256) {
        return RLP.toUint(RLP.toItem(b));
    }

    function testFuzz_randomProofsNeverProveMembership(bytes[] memory proof, uint8 idx) public view {
        vm.assume(proof.length < 8);
        try h.get(root, MerklePatricia.indexKey(idx), proof) returns (bool found, bytes memory) {
            assertFalse(found);
        } catch {}
    }

    function testFuzz_rlpNeverPanics(bytes memory b) public view {
        try this.decodeUint(b) {}
        catch (bytes memory err) {
            // Only our error (or a Solidity error from bounds), never a panic from overflow.
            assertTrue(err.length != 36 || bytes4(err) != bytes4(0x4e487b71));
        }
        try h.receipt(b) {}
        catch (bytes memory err) {
            assertTrue(err.length != 36 || bytes4(err) != bytes4(0x4e487b71));
        }
    }

    function _copy(bytes[] memory a) internal pure returns (bytes[] memory b) {
        b = new bytes[](a.length);
        for (uint256 i; i < a.length; ++i) {
            b[i] = bytes.concat(a[i]);
        }
    }

    function _slice(bytes memory b, uint256 from) internal pure returns (bytes memory out) {
        out = new bytes(b.length - from);
        for (uint256 i; i < out.length; ++i) {
            out[i] = b[from + i];
        }
    }
}
